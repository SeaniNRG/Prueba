        "\n",
        "N_arbol_superficie = 2  # periodos del arbol en cada punto de la malla\n",
        "\n",
        "S_grid_sup = np.linspace(15, 45, 100) # malla precio del limon en un rago de 15 a 45$/kg\n",
        "T_meses_grid = np.linspace(0.01, 12, 100) # malla vencimiento (meses) (para el grafico)\n",
        "T_grid_sup = T_meses_grid / 12 # malla vencimiento (años) (para las cuentas)\n",
        "\n",
        "def valor_bull_binomial(S, T, N=N_arbol_superficie):\n",
        "    larga = valuar_arbol_binomial_call(S0=S, K=K1, T=T, N=N, mostrar_grafico=False)[\"precio\"]\n",
        "    corta = valuar_arbol_binomial_call(S0=S, K=K2,T=T, N=N, mostrar_grafico=False)[\"precio\"]\n",
        "    return larga - corta\n",
        "\n",
        "# malla de precio, vencimiento\n",
        "S_mesh, T_mesh_meses = np.meshgrid(S_grid_sup, T_meses_grid) #Malla en la region para el grafico\n",
        "_, T_mesh_anios = np.meshgrid(S_grid_sup, T_grid_sup) # malla en la región S-T para las cuentas\n",
        "\n",
        "# Superficie para call\n",
        "V_binomial = np.zeros_like(S_mesh)\n",
        "for i, T_val in enumerate(T_grid_sup):\n",
        "    for j, S_val in enumerate(S_grid_sup):\n",
        "        V_binomial[i, j] = valuar_arbol_binomial_call(S0=S_val, T=T_val, mostrar_grafico=False)['precio']\n",
        "\n",
        "# superficie valuado conBlack-Scholes\n",
        "V_bs = bs_precio_call(S=S_mesh, K=32, T=T_mesh_anios)\n",
        "\n",
        "vmax_comun = max(V_binomial.max(), V_bs.max())"
