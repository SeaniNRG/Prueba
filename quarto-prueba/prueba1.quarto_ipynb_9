    "#| echo: false\n",
    "#| warning: false\n",
    "\n",
    "def bs_precio_call(S=30, K=32, r=0.06, sigma=0.3, T=2/12):\n",
    "    \"\"\"Precio de Black-Scholes para una call\"\"\"\n",
    "    d1 = (np.log(S / K) + (r + 0.5 * sigma**2) * T) / (sigma * np.sqrt(T))\n",
    "    d2 = d1 - sigma * np.sqrt(T)\n",
    "    return S * norm.cdf(d1) - K * np.exp(-r * T) * norm.cdf(d2)\n",
    "\n",
    "\n",
    "def bs_delta_call(S=30, K=32, r=0.06, sigma=0.3, T=2/12):\n",
    "    \"\"\"Delta derivada de Black-Scholes para una call\"\"\"\n",
    "    d1 = (np.log(S / K) + (r + 0.5 * sigma**2) * T) / (sigma * np.sqrt(T))\n",
    "    return norm.cdf(d1)"
   ]
