    "#| echo: false\n",
    "#| warning: false\n",
    "\n",
    "def valuar_arbol_binomial_call(S0=30.0, K=32.0, sigma=0.3, r=0.06, T=2 / 12,N=2, mostrar_grafico=True):\n",
    "    \"\"\"Funcion para valuar un arbol multiperiodo de manera inductiva hacia atrás, los parametros por default son los del ejemplo desarrollado en clase\"\"\"\n",
    "    dt = T / N #tamaño del intervao entre nodos\n",
    "    u = np.exp(sigma * np.sqrt(dt))#factor de subida por cada nodo\n",
    "    d = 1 / u #factor de bajada\n",
    "    disc = np.exp(-r * dt) #valor descontado\n",
    "    p = (np.exp(r * dt) - d)/(u - d) #p* de riesgo neutro de subida\n",
    "\n",
    "    j = np.arange(N + 1) # lista de pasos\n",
    "    ST = S0 * u**j * d**(N - j) # Posibles valores a vencimiento de S_T\n",
    "    C = np.maximum(ST - K, 0.0)  #Posibles payoffs\n",
    "    S_grid = [ST.copy()]\n",
    "    C_grid = [C.copy()]\n",
    "\n",
    "    for i in range(N - 1, -1, -1): # iteramos de manera inductiva hacia atras\n",
    "        jj = np.arange(i + 1) # vector de todos los nodos en el preriodo i\n",
    "        Si = S0 * u**jj * d**(i - jj) # se calculan los precios del limon en el periodo i (para obtener el grafico posterior)\n",
    "        C = disc * (p * C[1:] + (1 - p) * C[:-1]) # calcula de manera inductiva hacia atras con el mpdelo de un periodo\n",
    "        S_grid.append(Si.copy()) # se crea la malla con los valores de S\n",
    "        C_grid.append(C.copy()) # malla con los valores de la opcion\n",
    "    S_grid = S_grid[::-1] # se cambia la malla para que empiece de 0 a N en los valores\n",
    "    C_grid = C_grid[::-1] # se cambia la malla (se voltea)\n",
    "\n",
    "    C0 = C_grid[0][0] # precio de la opcion\n",
    "    Delta0 = (C_grid[1][1] - C_grid[1][0]) / (S_grid[1][1] - S_grid[1][0]) # delta inicial\n",
    "\n",
    "    # Delta de cada nodo \"rebalanceamos el portafolio que replica\"\n",
    "    deltas = []\n",
    "    for i in range(N):\n",
    "        Su_arr, Sd_arr = S_grid[i + 1][1:], S_grid[i + 1][:-1] # Precio del ativo en el nodo siguiente\n",
    "        Cu_arr, Cd_arr = C_grid[i + 1][1:], C_grid[i + 1][:-1] #Valor del derivado en el nodo siguiente\n",
    "        deltas.append((Cu_arr - Cd_arr) / (Su_arr - Sd_arr)) # calculo de la delta en cada nodo\n",
    "\n",
    "    resultado = dict(precio=C0, delta=Delta0, u=u, d=d, p=p, dt=dt, N=N,S_grid=S_grid, C_grid=C_grid, deltas=deltas, call='call')\n",
    "\n",
    "    if mostrar_grafico:\n",
    "        fig_w = max(9, 2.05 * N)\n",
    "        fig_h = max(7, 1.25 * (N + 1))\n",
    "        fig, ax = plt.subplots(figsize=(fig_w, fig_h))\n",
    "        node_size = max(50, 250 - 170 * N)\n",
    "        fs_price = max(7, 10.5 - 0.42 * N)\n",
    "        fs_label = max(6.3, 9 - 0.42 * N)\n",
    "\n",
    "        for i in range(N):\n",
    "            for j in range(i + 1):\n",
    "                x0, y0 = i, j - i / 2\n",
    "                x1u, y1u = i + 1, (j + 1) - (i + 1) / 2\n",
    "                x1d, y1d = i + 1, j - (i + 1) / 2\n",
    "                ax.plot([x0, x1u], [y0, y1u], color='gray', lw=1.3, zorder=1)\n",
    "                ax.plot([x0, x1d], [y0, y1d], color='gray', lw=1.3, zorder=1)\n",
    "\n",
    "        for i in range(N + 1):\n",
    "            for j in range(i + 1):\n",
    "                x, y = i, j - i / 2\n",
    "                Sval, Cval = S_grid[i][j], C_grid[i][j]\n",
    "                terminal = (i == N)\n",
    "                borde = 'red' if terminal else 'blue'\n",
    "                ax.scatter([x], [y], s=node_size, color=\"white\", edgecolor=borde,\n",
    "                           linewidth=1, zorder=2)\n",
    "                ax.text(x, y + 0.17, f\"S={Sval:.2f}\", ha=\"center\", va=\"bottom\",\n",
    "                        fontsize=fs_price, fontweight=\"bold\", zorder=4)\n",
    "                if terminal:\n",
    "                    ax.text(x, y - 0.17, f\"payoff ${Cval:.2f}\", ha=\"center\", va=\"top\",\n",
    "                            fontsize=fs_label, color='red', fontweight=\"bold\", zorder=4)\n",
    "                else:\n",
    "                    Dval = deltas[i][j]\n",
    "                    ax.text(x, y - 0.17, f\"V=${Cval:.2f}\\nDelta={Dval:.4f}\", ha=\"center\",\n",
    "                            va=\"top\", fontsize=fs_label, color='blue', zorder=4)\n",
    "\n",
    "        ax.set_xlim(-0.6, N + 0.6)\n",
    "        ax.set_ylim(-(N / 2) - 1.0, (N / 2) + 1.0)\n",
    "        ax.set_xticks(range(N + 1))\n",
    "        ax.set_xticklabels([f\"{i*dt*12:.2f}m\" for i in range(N + 1)])\n",
    "        ax.tick_params(axis=\"x\", length=0)\n",
    "        for spine in [\"top\", \"right\", \"left\"]:\n",
    "            ax.spines[spine].set_visible(False)\n",
    "        ax.spines[\"bottom\"].set_color(\"#c9c8c2\")\n",
    "        ax.set_yticks([])\n",
    "        kind_txt = \"call\"\n",
    "        ax.set_title(\n",
    "            f\"Arbol binomial de N={N} periodos - Opción: {kind_txt}\\n\"\n",
    "            f\"(S0={S0:.2f}, K={K:.2f} pesos/kg, r={r*100:.0f}%, T={T*12:.1f} meses, \"\n",
    "            f\"sigma={sigma*100:.1f}%, u={u:.4f}, d={d:.4f})\",\n",
    "            fontsize=11.5, fontweight=\"bold\", pad=14,\n",
    "        )\n",
    "        fig.tight_layout()\n",
    "        resultado[\"fig\"] = fig\n",
    "\n",
    "    return resultado"
   ]
