    "#| echo: false\n",
    "#| warning: false\n",
    "\n",
    "fig = make_subplots(rows=1, cols=2,\n",
    "    specs=[[{\"type\": \"scene\"}, {\"type\": \"scene\"}]],\n",
    "    subplot_titles=(f\"Arbol binomial (N={N_arbol_superficie})\", \"Black-Scholes\"),)\n",
    "\n",
    "fig.add_trace(go.Surface(\n",
    "        x=S_grid_sup, y=T_meses_grid, z=V_binomial,\n",
    "        colorscale=\"Blues\", cmin=0, cmax=vmax_comun,\n",
    "        showscale=False,\n",
    "        hovertemplate=(\n",
    "            \"S = %{x:.2f} $/kg<br>\"\n",
    "            \"Vencimiento = %{y:.2f} meses<br>\"\n",
    "            \"Valor (arbol) = %{z:.3f} $/kg<extra></extra>\"),),row=1, col=1,)\n",
    "\n",
    "fig.add_trace(go.Surface(\n",
    "        x=S_grid_sup, y=T_meses_grid, z=V_bs,\n",
    "        colorscale=\"Oranges\", cmin=0, cmax=vmax_comun,\n",
    "        showscale=False,\n",
    "        hovertemplate=(\n",
    "            \"S = %{x:.2f} $/kg<br>\"\n",
    "            \"Vencimiento = %{y:.2f} meses<br>\"\n",
    "            \"Valor (BS) = %{z:.3f} $/kg<extra></extra>\"),),row=1, col=2,)\n",
    "\n",
    "S0 = 30.0\n",
    "indice_malla_S = np.argmin(np.abs(S_grid_sup - S0))\n",
    "\n",
    "fig.add_trace(go.Scatter3d(\n",
    "        x=np.full_like(T_meses_grid, S0), y=T_meses_grid, z=V_binomial[:, indice_malla_S],\n",
    "        mode=\"lines\", line=dict(color=\"black\", width=10, dash=\"solid\"),\n",
    "        name=\"Precio S=30\", showlegend=True,\n",
    "        hovertemplate=\"S = 30 $/kg<br>Vencimiento = %{y:.2f} meses<br>Valor = %{z:.3f} $/kg<extra></extra>\",\n",
    "    ), row=1, col=1)\n",
    "\n",
    "fig.add_trace(go.Scatter3d(\n",
    "        x=np.full_like(T_meses_grid, S0), y=T_meses_grid, z=V_bs[:, indice_malla_S],\n",
    "        mode=\"lines\", line=dict(color=\"black\", width=10, dash=\"solid\"),\n",
    "        name=\"Precio S=30\", showlegend=False,\n",
    "        hovertemplate=\"S = 30 $/kg<br>Vencimiento = %{y:.2f} meses<br>Valor = %{z:.3f} $/kg<extra></extra>\",\n",
    "    ), row=1, col=2)\n",
    "\n",
    "camara = dict(eye=dict(x=1.5, y=-1.7, z=0.9))\n",
    "ejes_comunes = dict(\n",
    "    xaxis_title=\"S ($/kg)\",\n",
    "    yaxis_title=\"Vencimiento (meses)\",\n",
    "    zaxis=dict(title=\"Valor ($/kg)\", range=[0, vmax_comun]),\n",
    "    camera=camara,\n",
    "    aspectratio=dict(x=1, y=1, z=0.8))\n",
    "fig.update_layout(\n",
    "    title=f\"Call (K=32)\",\n",
    "    scene=ejes_comunes,\n",
    "    scene2=ejes_comunes,\n",
    "    legend=dict(x=0.42, y=0.05),\n",
    "    width=1150, height=580,\n",
    "    margin=dict(l=0, r=0, t=90, b=0))\n",
    "\n",
    "fig.show()"
